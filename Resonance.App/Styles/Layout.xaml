<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:Double x:Key="WindowWidth">1120</sys:Double><sys:Double x:Key="WindowHeight">780</sys:Double>
  <sys:Double x:Key="MinimumWindowWidth">860</sys:Double><sys:Double x:Key="MinimumWindowHeight">600</sys:Double>
  <sys:Double x:Key="DialogWidth">760</sys:Double><sys:Double x:Key="DialogHeight">680</sys:Double>
  <sys:Double x:Key="QueueHeight">180</sys:Double><sys:Double x:Key="InputAreaHeight">100</sys:Double>
  <sys:Double x:Key="ArtSize">64</sys:Double><sys:Double x:Key="SidebarSize">180</sys:Double>
  <sys:Double x:Key="PlaylistListSize">220</sys:Double><sys:Double x:Key="SortSize">140</sys:Double>
  <sys:Double x:Key="VolumeSize">120</sys:Double><sys:Double x:Key="ProgressHeight">4</sys:Double>
  <GridLength x:Key="SidebarWidth">180</GridLength><GridLength x:Key="ArtColumn">56</GridLength>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Padding" Value="{DynamicResource InnerPadding}"/>
    <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="{DynamicResource InnerRadius}" Padding="{DynamicResource ControlPadding}"><TextBlock HorizontalAlignment="Right" Text="⌄"/></Border></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="{DynamicResource ControlPadding}" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
      <Border x:Name="Focus" IsHitTestVisible="False" BorderThickness="1" CornerRadius="{DynamicResource InnerRadius}"/>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
