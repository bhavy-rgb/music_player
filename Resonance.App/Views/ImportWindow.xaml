<Window x:Class="Resonance.App.Views.ImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Import playlist — Resonance" Width="{DynamicResource DialogWidth}" Height="{DynamicResource DialogHeight}" WindowStartupLocation="CenterOwner">
  <Grid Margin="{DynamicResource PagePadding}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Import playlist" Style="{DynamicResource Heading}"/>
    <TextBox Grid.Row="1" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="{DynamicResource InputAreaHeight}" VerticalScrollBarVisibility="Auto" MaxLength="4194304" AutomationProperties.Name="Playlist URL file path or Artist - Title lines"/>
    <WrapPanel Grid.Row="2"><Button Content="Choose file" Click="ChooseFile"/><Button Content="Resolve and match" Command="{Binding ResolveCommand}" Style="{DynamicResource PrimaryButton}"/><Button Content="Cancel operation" Command="{Binding CancelCommand}"/><Button Content="Select all" Command="{Binding SelectAllCommand}"/><Button Content="Select none" Command="{Binding SelectNoneCommand}"/></WrapPanel>
    <TextBox Grid.Row="3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" AutomationProperties.Name="Playlist name"/>
    <ListBox Grid.Row="4" ItemsSource="{Binding Rows}" AutomationProperties.Name="Tracks to import"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{DynamicResource Caption}"/><CheckBox IsChecked="{Binding Included}" AutomationProperties.Name="{Binding Title}"><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Style="{DynamicResource MutedText}"/></StackPanel></CheckBox></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Row="5"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><ProgressBar Height="{DynamicResource ProgressHeight}" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/><WrapPanel HorizontalAlignment="Right"><Button Content="Close" Click="CloseDialog"/><Button Content="Save selected tracks" Command="{Binding SaveCommand}" IsEnabled="{Binding Resolved}" Style="{DynamicResource PrimaryButton}"/></WrapPanel></StackPanel>
  </Grid>
</Window>
